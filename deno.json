{
  "tasks": {
    "dev": "deno run --allow-read --allow-net --watch ./server.ts",
    "frontend": "deno run --allow-read --allow-net --watch ./server.ts",
    "ai": "deno run --allow-read --allow-run --allow-net --watch ./server/server.ts",
    "server": "deno run --allow-read --allow-run --allow-net --watch ./server/server.ts"
  },
  "imports": {
    "@sabaki/boardmatcher": "npm:@sabaki/boardmatcher@^1.3.0",
    "@sabaki/boardmatcher/library": "npm:@sabaki/boardmatcher@^1.3.0/library/index.js",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "lint": {
    "include": ["server.ts", "server/"],
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
